        "Open title",
        "Select episode",
        "Open local mock player"
      ],
      "outcome": "Playback shell opens without external streaming dependency."
    },
    {
      "id": "library-loop",
      "actor": "viewer",
      "title": "Track progress",
      "trigger": "Open Library",
      "steps": [
        "Inspect statuses",
        "Resume progress",
        "Open collection",
        "Review history"
      ],
      "outcome": "Synthetic state exercises extracted Library UI."
